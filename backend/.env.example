# HandDeck FastAPI Backend Configuration
# Copy this file to .env and insert your API key(s)
# Never commit .env to git!

# LLM Providers (Provide at least one, or leave blank to use built-in topic fallbacks)
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# Server Configuration
HOST=0.0.0.0
PORT=8000

# CORS allowed origins.
# Local dev:   ALLOWED_ORIGINS=*
# Production:  ALLOWED_ORIGINS=https://lovechauhan-18.github.io
# Multiple:    ALLOWED_ORIGINS=https://lovechauhan-18.github.io,http://localhost:5173
ALLOWED_ORIGINS=*

RATE_LIMIT_PER_MINUTE=60
MAX_REQUEST_BYTES=1048576

